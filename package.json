{
  "name": "polr-stocks",
  "version": "0.3.0",
  "description": "Polr Stocks for Home Assistant.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit",
    "pretest": "esbuild src/stocks.ts --bundle --format=esm --outfile=test/.build/stocks.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
